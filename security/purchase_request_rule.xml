<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Rule cho Người dùng: CHỈ nhìn thấy phiếu do CHÍNH MÌNH tạo -->
        <record id="purchase_request_user_rule" model="ir.rule">
            <field name="name">Yêu cầu mua hàng - Người dùng chỉ thấy phiếu của mình</field>
            <field name="model_id" ref="model_purchase_request"/>
            <field name="groups" eval="[(4, ref('group_purchase_request_user'))]"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
        </record>

        <!-- Rule cho Quản lý: Nhìn thấy TẤT CẢ các phiếu -->
        <record id="purchase_request_manager_rule" model="ir.rule">
            <field name="name">Yêu cầu mua hàng - Quản lý thấy toàn bộ phiếu</field>
            <field name="model_id" ref="model_purchase_request"/>
            <field name="groups" eval="[(4, ref('group_purchase_request_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
    </data>
</odoo>